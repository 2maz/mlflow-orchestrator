version: "3.7"
services:
{%- if use_nginx %}
  nginx:
    image: nginx:1.25.5-alpine-slim
    volumes:
      -  ./nginx-default.conf.template:/etc/nginx/templates/default.conf.template
      - ./nginx/mlflow-instances:/etc/nginx/mlflow-instances
    ports:
      - 8888:8888
{%- if not use_minio %}
      - 9000:9000
      - 9001:9001
{% endif %}
{%- endif %}
{%- if use_minio %}
  minio:
    image: quay.io/minio/minio
    command: server /data --console-address 0.0.0.0:9001
    volumes:
      -  ./minio-data:/data
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    ports:
      - 9000:9000
      - 9001:9001
{% endif -%}
